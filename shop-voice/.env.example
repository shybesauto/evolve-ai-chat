# Shop Voice Assistant — environment
#
# THIS FILE LIVES OUTSIDE public_html. Copy to `.env` next to it and fill in.
# If .env ever ends up inside the web root, a server misconfiguration serves it
# as plain text and leaks the Shopmonkey token. See docs/operations.md.

APP_ENV=production
APP_DEBUG=false
APP_TIMEZONE=America/Detroit

# --- Database (cPanel MySQL) ---------------------------------------------
DB_DSN=mysql:host=localhost;dbname=shybes_shopvoice;charset=utf8mb4
DB_USER=shybes_voice
DB_PASS=

# --- Shopmonkey ------------------------------------------------------------
# Russ's API token. The tablet NEVER holds this value.
SHOPMONKEY_TOKEN=
SHOPMONKEY_BASE_URL=https://api.shopmonkey.cloud/v3/
# fixture = run the whole system on bundled sample data, no token needed.
# live    = talk to the real API. Only flip this after tools/probe_shopmonkey.php
#           has confirmed the endpoint shapes in config/shopmonkey_endpoints.php.
SHOPMONKEY_MODE=fixture

# --- Intent model provider (swappable seam, see docs/architecture.md) ------
# groq | openai | anthropic | mock
INTENT_PROVIDER=mock
INTENT_CONFIDENCE_THRESHOLD=0.70

GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# --- Notes -----------------------------------------------------------------
# local      = our own dictated_notes table (the §2 fallback; safe default)
# shopmonkey = push internal notes to Shopmonkey. DO NOT ENABLE until the write
#              endpoint is confirmed and docs/shopmonkey-api-findings.md is
#              filled in and reviewed.
NOTE_STORE=local

# --- Sessions --------------------------------------------------------------
SESSION_IDLE_MINUTES=720
# Nightly auto-logout, local shop time. Cron runs tools/nightly_logout.php.
NIGHTLY_LOGOUT_AT=03:00
UNDO_WINDOW_SECONDS=30
INSPECTION_IDLE_SECONDS=300

# --- ALLDATA (build step 6; unused until then) -----------------------------
ALLDATA_USER=
ALLDATA_PASS=
IDENTIFIX_USER=
IDENTIFIX_PASS=
