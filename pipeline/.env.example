# ============================================================
# Motivational Video Pipeline — Environment Variables
# Copy this file to .env and fill in your keys.
# ============================================================

# --- Anthropic (required for Research + Script agents) ---
ANTHROPIC_API_KEY=sk-ant-...

# --- ElevenLabs (required for voiceover) ---
ELEVENLABS_API_KEY=...
# Voice IDs from your ElevenLabs account (or use defaults below)
ELEVENLABS_VOICE_ID=pNInz6obpgDQGcFmaJgB   # "Adam" — deep, energetic
ELEVENLABS_VOICE_ID_FEMALE=EXAVITQu4vr4xnSDxMaL  # "Bella"

# --- Pexels (required for stock footage — free tier is generous) ---
PEXELS_API_KEY=...

# --- Brave Search (required for Research Agent web search) ---
# Free tier: 2,000 queries/month — https://brave.com/search/api/
BRAVE_SEARCH_API_KEY=...

# --- YouTube Data API v3 (required for YouTube upload) ---
# Create OAuth credentials at https://console.cloud.google.com
YOUTUBE_CLIENT_ID=...
YOUTUBE_CLIENT_SECRET=...
YOUTUBE_REFRESH_TOKEN=...    # Run: python pipeline/setup_youtube_auth.py

# --- TikTok for Business API (required for TikTok upload) ---
# Apply at https://developers.tiktok.com
TIKTOK_ACCESS_TOKEN=...
TIKTOK_OPEN_ID=...

# --- Pipeline settings (optional, defaults shown) ---
OUTPUT_DIR=pipeline/output
DB_PATH=pipeline/pipeline.db
LOG_DIR=pipeline/logs
MAX_QUEUE_SIZE=20
RESEARCH_INTERVAL_HOURS=6
AUTO_START=false
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=5050
DASHBOARD_SECRET_KEY=change-me-in-production
